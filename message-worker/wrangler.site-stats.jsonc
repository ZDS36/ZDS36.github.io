{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "between-states-site-stats",
  "main": "src/site-stats.mjs",
  "compatibility_date": "2026-11-04",
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": false },
  "vars": {
    "ALLOWED_ORIGIN": "https://zds36.github.io",
    "HISTORICAL_CLICKS": 1256
  },
  "ratelimits": [{ "name": "SITE_STATS_LIMIT", "namespace_id": "26261101", "simple": { "limit": 90, "period": 60 } }],
  "durable_objects": {
    "bindings": [{ "name": "SITE_STATS", "class_name": "SiteStats" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SiteStats"] }]
}
